# コピーして .env にし、パスワードを変えてください（.env は Git に入れない）
POSTGRES_PASSWORD=change-me
DB_PORT=55433
# アプリの設定
DATABASE_URL=postgresql+psycopg://crm:change-me@127.0.0.1:55433/crm
TEST_DATABASE_URL=postgresql+psycopg://crm:change-me@127.0.0.1:55433/crm_test
APP_PORT=8100
# 本番で HTTPS を使うときだけ true（Cookie に Secure を付ける）
COOKIE_SECURE=false
